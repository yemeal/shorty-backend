# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT and password hashing
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SECRET_KEY=your_secret_key
ALGORITHM=HS256

# Cookies
COOKIE_SECURE=bool
COOKIE_SAMESITE=lax/strict/none
COOKIE_DOMAIN=optional

# CSRF
# Vite dev: и localhost, и 127.0.0.1 — разные Origin в браузере
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,https://шорти.рф,https://xn--h1algi1a.xn--p1ai